{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm start",
  "installCommand": "npm install",
  "builds": [{
    "src": "./index.js",
    "use": "@vercel/node"
  }],
  "routes": [{"handle": "filesystem"},
    {
      "src": "/.*",
      "dest": "index.js"
    }
  ]
}
