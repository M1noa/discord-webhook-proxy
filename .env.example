# Discord Webhook Configuration (REQUIRED)
WEBHOOK_ID=your_webhook_id_here
WEBHOOK_TOKEN=your_webhook_token_here

# Server Configuration
PORT=3000

# Security Configuration (OPTIONAL)
# Leave empty or remove for no authentication (drop-in Discord webhook replacement)
# Set to enable enhanced security features and higher rate limits
API_KEY=your_secure_api_key_here

# Proxy Configuration
# Set to true if running behind Cloudflare, Vercel, or other proxy
BEHIND_PROXY=false

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=5

# Content Limits
MAX_CONTENT_LENGTH=2000
MAX_EMBEDS=10

# Example webhook URL format:
# https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Extract WEBHOOK_ID and WEBHOOK_TOKEN from your Discord webhook URL